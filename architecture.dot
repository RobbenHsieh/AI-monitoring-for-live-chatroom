digraph ArchitectureGraph {
    rankdir=TB;
    compound=true;
    node [fontname="Microsoft JhengHei"];
    edge [fontname="Microsoft JhengHei"];
    graph [fontname="Microsoft JhengHei", ranksep=0.8, nodesep=0.6];

    // Global Graph Styling
    bgcolor="#1E1E1E";
    color="#FFFFFF";
    fontcolor="#FFFFFF";

    node [
        shape=box,
        style="filled, rounded",
        color="#333333",
        fillcolor="#2D2D2D",
        fontcolor="#FFFFFF",
        margin=0.2
    ];

    edge [
        color="#888888",
        fontcolor="#CCCCCC",
        fontsize=10,
        arrowhead=vee,
        penwidth=1.5
    ];

    // --- Subgraph: Data Schemas ---
    subgraph cluster_schemas {
        label = "資料模型與契約 (schemas.py)";
        style="rounded,filled";
        fillcolor="#252526";
        color="#3F3F46";
        fontcolor="#4EC9B0";

        AgentState [label="AgentState (Enum)\n- IDLE_ICEBREAKER\n- ACTIVE_INTERACTION\n- VIOLATION_CIRCUIT_BREAKER", fillcolor="#1E1E1E", color="#4EC9B0"];
        ActionType [label="ActionType (Enum)\n- RENDER_TEXT\n- RENDER_BUTTONS\n- TRIGGER_ALERT", fillcolor="#1E1E1E", color="#4EC9B0"];
        UIPayload [label="UIPayload (BaseModel)\n- buttons\n- alert_level\n- alert_message", fillcolor="#1E1E1E", color="#4EC9B0"];
        UIAction [label="UIAction (BaseModel)\n- action_type\n- payload", fillcolor="#1E1E1E", color="#4EC9B0"];
        AgentResponsePayload [label="AgentResponsePayload (BaseModel)\n- current_state\n- thought_process\n- display_message\n- translation_zh\n- ui_actions\n- usage_metadata", fillcolor="#1E1E1E", color="#4EC9B0"];
    }

    // --- Subgraph: Core Engine ---
    subgraph cluster_engine {
        label = "核心引擎 (engine.py)";
        style="rounded,filled";
        fillcolor="#252526";
        color="#3F3F46";
        fontcolor="#CE9178";

        LiveInteractionEngine [label="LiveInteractionEngine (Class)\n- __init__(api_key, model_name)\n- evaluate_and_respond(idle_seconds, viewer_message)\n- _fallback_response()", fillcolor="#1E1E1E", color="#CE9178"];
    }

    // --- Subgraph: YouTube Stream & Listener ---
    subgraph cluster_youtube {
        label = "YouTube 串流與彈幕監聽 (youtube_stream.py)";
        style="rounded,filled";
        fillcolor="#252526";
        color="#3F3F46";
        fontcolor="#DCDCAA";

        extract_video_id [label="extract_video_id()", fillcolor="#1E1E1E", color="#DCDCAA"];
        YouTubeChatListener [label="YouTubeChatListener (Class)\n- __init__(video_url)\n- get_latest_chat_batch()", fillcolor="#1E1E1E", color="#DCDCAA"];
        fetch_youtube_concurrent_viewers [label="fetch_youtube_concurrent_viewers()", fillcolor="#1E1E1E", color="#DCDCAA"];
    }

    // --- Subgraph: Streamlit Web App ---
    subgraph cluster_app {
        label = "Streamlit 前端與調度中樞 (app.py)";
        style="rounded,filled";
        fillcolor="#252526";
        color="#3F3F46";
        fontcolor="#569CD6";

        AppMain [label="App 主控台邏輯\n- 環境與金鑰載入\n- FSM 狀態流轉控制\n- 預算與風控治理", fillcolor="#1E1E1E", color="#569CD6"];
        render_live_chatroom_stream [label="render_live_chatroom_stream()\n(@st.fragment run_every='3s')\n- 聊天室串流與 AI 互動", fillcolor="#1E1E1E", color="#569CD6"];
        render_analytics_dashboard_hub [label="render_analytics_dashboard_hub()\n(@st.fragment run_every='8s')\n- Performance / LLMOps / STT Hub", fillcolor="#1E1E1E", color="#569CD6"];
        AudioPipeline [label="雙軌音訊切片管線\n- start_virtual_audio_simulation()\n- start_audio_slicing_pipeline_real()\n- transcribe_audio_chunk_with_gemini()", fillcolor="#1E1E1E", color="#569CD6"];
    }

    // --- Relationships & Data Flows ---

    // Schemas internal references
    UIAction -> ActionType [style=dashed, label="uses"];
    UIAction -> UIPayload [style=dashed, label="uses"];
    AgentResponsePayload -> AgentState [style=dashed, label="uses"];
    AgentResponsePayload -> UIAction [style=dashed, label="contains"];

    // Engine uses Schemas
    LiveInteractionEngine -> AgentResponsePayload [color="#CE9178", label="Returns Structured JSON"];
    LiveInteractionEngine -> AgentState [color="#CE9178", label="Evaluates States"];

    // App imports and uses Engine & Schemas
    AppMain -> LiveInteractionEngine [color="#569CD6", label="Initializes & Calls"];
    AppMain -> YouTubeChatListener [color="#569CD6", label="Instantiates"];
    AppMain -> AgentState [color="#569CD6", label="Tracks State Machine"];

    // YouTube Stream dependencies
    YouTubeChatListener -> extract_video_id [color="#DCDCAA", label="Calls"];
    fetch_youtube_concurrent_viewers -> extract_video_id [style=dashed, label="Uses Video ID"];

    // Fragments and App execution flow
    render_live_chatroom_stream -> LiveInteractionEngine [color="#569CD6", label="Calls evaluate_and_respond()"];
    render_live_chatroom_stream -> YouTubeChatListener [color="#569CD6", label="Fetches chat batch"];
    render_analytics_dashboard_hub -> AudioPipeline [color="#569CD6", label="Audits STT & Metrics"];

    // FSM State Transition representation within App/Engine
    AgentState -> AgentState [color="#4EC9B0", label="FSM Transition:\nIDLE_ICEBREAKER ⇄ ACTIVE_INTERACTION\n↓ (Violation)\nVIOLATION_CIRCUIT_BREAKER", constraint=false];
}